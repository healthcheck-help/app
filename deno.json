{
  "nodeModulesDir": "auto",
  "workspace": ["./apps/*", "./libs/*"],
  "tasks": {
    "build": "deno task -f @healthcheck/theme build && deno task -f @healthcheck/core build",
    "dev": "deno task -f @healthcheck/theme build && (deno task -f @healthcheck/theme dev & deno task -f @healthcheck/core dev)",
    "upgrade": "deno outdated --update",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "tag": "changeset tag",
    "test:e2e": "deno task -f @healthcheck/core test:e2e",
    "test": "deno task -f @healthcheck/core test",
    "version": "changeset version && deno install",
    "changeset": "changeset"
  },
  "imports": {
    "@biomejs/biome": "npm:@biomejs/biome@^2.4.14",
    "@changesets/cli": "npm:@changesets/cli@^2.31.0",
    "@iconify-json/tabler": "npm:@iconify-json/tabler@^1.2.34",
    "@types/node": "npm:@types/node@^25.6.2"
  },
  "allowScripts": [
    "npm:esbuild@0.18.20",
    "npm:esbuild@0.25.12",
    "npm:esbuild@0.28.0"
  ]
}
