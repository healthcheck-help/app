{
  "nodeModulesDir": "auto",
  "workspace": [
    "./apps/core",
    "./libs/auth",
    "./libs/db",
    "./libs/i18n",
    "./libs/theme",
    "./libs/repo"
  ],
  "tasks": {
    "build": "deno task -f @healthcheck/theme build && deno task -f @healthcheck/core build",
    "dev": "deno task -f @healthcheck/theme build && (deno task -f @healthcheck/theme dev & deno task -f @healthcheck/core dev)",
    "preview": "deno task build && deno task -f @healthcheck/core preview",
    "migrate": "deno run --allow-all apps/core/scripts/migrate.ts",
    "upgrade": "deno outdated -u -r -i --latest",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "biome": "biome",
    "tag": "changeset tag",
    "test:e2e:all": "deno task -r test:e2e",
    "test:unit:all": "deno task -r test:unit",
    "test:all": "deno task -r test",
    "version": "changeset version && deno install",
    "changeset": "changeset"
  },
  "imports": {
    "@biomejs/biome": "npm:@biomejs/biome@^2.5.6",
    "@changesets/cli": "npm:@changesets/cli@^2.31.1",
    "@iconify-json/tabler": "npm:@iconify-json/tabler@^1.2.38",
    "@types/node": "npm:@types/node@^26.1.2",
    "unplugin-icons": "npm:unplugin-icons@^23.0.1"
  },
  "allowScripts": [
    "npm:esbuild@0.18.20",
    "npm:esbuild@0.25.12",
    "npm:esbuild@0.28.0"
  ]
}
