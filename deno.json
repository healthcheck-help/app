{
  "license": "AGPL-3.0-only",
  "nodeModulesDir": "auto",
  "workspace": [
    "./apps/core",
    "./libs/auth",
    "./libs/db",
    "./libs/i18n",
    "./libs/theme"
  ],
  "tasks": {
    "build": "deno task -f @healthcheck/theme build && deno task -f @healthcheck/core build",
    "dev": "deno task -f @healthcheck/theme build && (deno task -f @healthcheck/theme dev & deno task -f @healthcheck/core dev)",
    "preview": "deno task build && deno task -f @healthcheck/core preview",
    "migrate": "deno run --allow-all apps/core/scripts/migrate.ts",
    "upgrade": "deno outdated -u -r -i --latest",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "tag": "changeset tag",
    "test:e2e": "deno task -f @healthcheck/core test:e2e",
    "test": "deno task -f @healthcheck/core test",
    "version": "changeset version && deno install",
    "changeset": "changeset"
  },
  "imports": {
    "@biomejs/biome": "npm:@biomejs/biome@^2.4.16",
    "@changesets/cli": "npm:@changesets/cli@^2.31.0",
    "@iconify-json/tabler": "npm:@iconify-json/tabler@^1.2.35",
    "@types/node": "npm:@types/node@^25.9.2",
    "unplugin-icons": "npm:unplugin-icons@^23.0.1"
  },
  "allowScripts": [
    "npm:esbuild@0.18.20",
    "npm:esbuild@0.25.12",
    "npm:esbuild@0.28.0"
  ]
}
