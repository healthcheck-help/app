{
  "name": "@healthcheck/core",
  "version": "0.0.1",
  "exports": {},
  "tasks": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:e2e": "playwright test",
    "test": "deno task test:e2e"
  },
  "imports": {
    "@deno/svelte-adapter": "npm:@deno/svelte-adapter@^0.1.1",
    "@healthcheck/auth": "workspace:*",
    "@healthcheck/db": "workspace:*",
    "@healthcheck/i18n": "workspace:*",
    "@healthcheck/theme": "workspace:*",
    "drizzle-orm": "npm:drizzle-orm@^0.45.2",
    "@iconify-json/tabler": "npm:@iconify-json/tabler@^1.2.34",
    "@playwright/test": "npm:@playwright/test@^1.59.1",
    "@poppanator/sveltekit-svg": "npm:@poppanator/sveltekit-svg@^7.0.0",
    "@sveltejs/adapter-node": "npm:@sveltejs/adapter-node@^5.5.4",
    "@sveltejs/kit": "npm:@sveltejs/kit@^2.59.1",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.1.2",
    "svelte": "npm:svelte@^5.55.5",
    "svelte-check": "npm:svelte-check@^4.4.8",
    "typescript": "npm:typescript@^6.0.3",
    "unplugin-icons": "npm:unplugin-icons@^23.0.1",
    "vite": "npm:vite@^8.0.11",
    "vite-plugin-devtools-json": "npm:vite-plugin-devtools-json@^1.0.0"
  }
}
