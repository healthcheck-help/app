{
  "name": "@healthcheck/core",
  "version": "0.0.1",
  "exports": {},
  "tasks": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:e2e": "playwright test",
    "test": "deno task test:e2e"
  },
  "imports": {
    "@healthcheck/auth": "@healthcheck/auth",
    "@healthcheck/db": "@healthcheck/db",
    "@deno/svelte-adapter": "npm:@deno/svelte-adapter@^0.1.1",
    "@nanostores/i18n": "npm:@nanostores/i18n@^1.3.3",
    "@libsql/client": "npm:@libsql/client@^0.17.3",
    "@libsql/kysely-libsql": "npm:@libsql/kysely-libsql@^0.4.1",
    "better-auth": "npm:better-auth@^1.6.11",
    "bits-ui": "npm:bits-ui@^2.18.1",
    "drizzle-orm": "npm:drizzle-orm@^0.45.2",
    "@iconify-json/tabler": "npm:@iconify-json/tabler@^1.2.35",
    "@playwright/test": "npm:@playwright/test@^1.60.0",
    "@poppanator/sveltekit-svg": "npm:@poppanator/sveltekit-svg@^7.0.0",
    "@sveltejs/adapter-node": "npm:@sveltejs/adapter-node@^5.5.4",
    "@sveltejs/kit": "npm:@sveltejs/kit@^2.61.1",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.1.2",
    "svelte": "npm:svelte@^5.55.10",
    "svelte-check": "npm:svelte-check@^4.4.8",
    "nanostores": "npm:nanostores@^1.3.0",
    "typescript": "npm:typescript@^6.0.3",
    "vite": "npm:vite@^8.0.14"
  }
}
