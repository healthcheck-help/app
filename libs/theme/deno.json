{
  "name": "@healthcheck/theme",
  "version": "0.0.1",
  "tasks": {
    "dev": "svelte-kit sync && svelte-package --watch --input=src",
    "build": "svelte-kit sync && svelte-package --input=src",
    "check-types": "svelte-check --tsconfig ./tsconfig.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./index.css": "./src/index.css"
  },
  "imports": {
    "svelte": "npm:svelte@^5.55.9",
    "bits-ui": "npm:bits-ui@^2.18.1",
    "@fontsource-variable/fraunces": "npm:@fontsource-variable/fraunces@^5.2.9",
    "@fontsource-variable/readex-pro": "npm:@fontsource-variable/readex-pro@^5.2.11",
    "@sveltejs/kit": "npm:@sveltejs/kit@^2.61.1",
    "@sveltejs/package": "npm:@sveltejs/package@^2.5.7",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.1.2",
    "svelte-check": "npm:svelte-check@^4.4.8",
    "vite": "npm:vite@^8.0.14"
  }
}
